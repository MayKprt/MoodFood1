# All integrations are optional. The app runs in guest demo mode by default.
# Supabase authentication (server only); apply migrations before production integration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side natural language interpretation. Never use NEXT_PUBLIC_ for credentials.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Enable only behind HTTPS in a deployed environment.
DEPLOYMENT_HTTPS=false
# Optional path for single-process demo order storage; default .data/.
MOODFOOD_DATA_DIR=

# Optional local rehearsal of the public, integration-free portfolio demo.
MOODFOOD_PUBLIC_DEMO=false
